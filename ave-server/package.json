{
  "name": "ave-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev -c wrangler.toml -c ../ave-heavy-services/wrangler.jsonc",
    "start": "wrangler dev -c wrangler.toml -c ../ave-heavy-services/wrangler.jsonc",
    "deploy": "CLOUDFLARE_ACCOUNT_ID=2e3bfcbc9512a7ab1ea3a9cb9a474b30 wrangler deploy --keep-vars",
    "check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npm run db:migrate:local",
    "db:migrate:local": "wrangler d1 migrations apply ave --local",
    "db:migrate:remote": "CLOUDFLARE_ACCOUNT_ID=2e3bfcbc9512a7ab1ea3a9cb9a474b30 wrangler d1 migrations apply ave --remote",
    "db:export:neon": "node ./scripts/export-neon-to-d1.mjs",
    "db:import:data:local": "wrangler d1 execute ave --local --file ./tmp/neon-data.sql",
    "db:import:data:remote": "CLOUDFLARE_ACCOUNT_ID=2e3bfcbc9512a7ab1ea3a9cb9a474b30 wrangler d1 execute ave --remote --file ./tmp/neon-data.sql"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.3.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@types/node": "^26.3.0",
    "drizzle-kit": "^0.31.10",
    "postgres": "^3.4.9",
    "typescript": "^7.0.2",
    "wrangler": "^4.126.0"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
