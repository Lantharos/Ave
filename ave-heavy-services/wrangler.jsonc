{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ave-heavy-services",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
