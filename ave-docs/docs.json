            "pages": [
              "reference/how-it-works",
              "reference/base-urls-and-concepts"
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Encryption",
            "pages": [
              "guides/end-to-end-encryption",
              "guides/e2ee-integration-checklist"
            ]
          },
          {
            "group": "Sign-in",
            "pages": [
              "guides/oauth-authorization-code-flow",
              "guides/pkce-for-public-clients",
              "guides/server-side-confidential-clients",
              "guides/scopes-and-claims",
              "guides/ave-session-and-tokens"
            ]
          },
          {
            "group": "Building on Ave",
            "pages": [
              "guides/app-authorization"
            ]
          },
          {
            "group": "Frameworks",
            "pages": [
              "guides/expo-auth-session",
              "guides/convex-custom-auth"
            ]
          }
        ]
      },
      {
        "tab": "SDKs",
        "groups": [
          {
            "group": "JavaScript SDK",
            "pages": [
              "sdk/javascript-sdk",
              "sdk/sdk-identity-keys",
              "sdk/sdk-oauth"
            ]
          },
          {
            "group": "Embed SDK",
            "pages": [
              "sdk/embed-sdk"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Endpoints",
            "pages": [
              "api/overview",
              "api/oauth-endpoints",
              "api/encryption-endpoints"
            ]
          }
        ]
      },
      {
        "tab": "Security",
        "groups": [
          {
            "group": "Security",
            "pages": [
              "security/encryption-model-and-key-lifecycle",
              "security/best-practices"
            ]
          },
          {
            "group": "Troubleshooting",
            "pages": [
              "troubleshooting/common-mistakes-and-edge-cases",
              "troubleshooting/recover-app-key"
            ]
          }
        ]
