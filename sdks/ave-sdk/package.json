{
  "name": "@ave-id/sdk",
  "version": "0.12.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./app-key": {
      "types": "./dist/crypto/app-key.d.ts",
      "default": "./dist/crypto/app-key.js"
    },
    "./app-encryption": {
      "types": "./dist/crypto/app-encryption.d.ts",
      "default": "./dist/crypto/app-encryption.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./session": {
      "types": "./dist/session/session.d.ts",
      "default": "./dist/session/session.js"
    },
    "./session-storage": {
      "types": "./dist/session/session-storage.d.ts",
      "default": "./dist/session/session-storage.js"
    },
    "./convex": {
      "types": "./dist/integrations/convex.d.ts",
      "default": "./dist/integrations/convex.js"
    },
    "./svelte": {
      "types": "./dist/integrations/svelte.d.ts",
      "default": "./dist/integrations/svelte.js"
    },
    "./expo-lifecycle": {
      "types": "./dist/integrations/expo-lifecycle.d.ts",
      "default": "./dist/integrations/expo-lifecycle.js"
    },
    "./expo-session": {
      "types": "./dist/integrations/expo-session.d.ts",
      "default": "./dist/integrations/expo-session.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lantharos/Ave"
  }
}
